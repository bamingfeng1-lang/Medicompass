# Anthropic API key for AI summarization (required for the AI feature).
# Get one at https://console.anthropic.com/ — or use a compatible proxy key.
ANTHROPIC_API_KEY=

# Optional: custom API base URL (e.g. a self-hosted/proxy gateway).
# Leave blank to use the official Anthropic API.
ANTHROPIC_BASE_URL=

# Optional: model to use. Defaults to claude-opus-5.
ANTHROPIC_MODEL=

# SQLite database file (path is relative to the prisma/ folder).
DATABASE_URL="file:../data/app.db"

# Secret used to sign admin session cookies. Use a long random string.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# Default admin account created by `npm run db:seed`.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
