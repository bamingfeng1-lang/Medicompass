# ---------------------------------------------------------------------
# Medicompass FastAPI backend — environment variables
# Copy to `.env` and fill in. Do NOT commit the real `.env`.
# ---------------------------------------------------------------------

# MySQL connection (SQLAlchemy + PyMySQL).
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<db>?charset=utf8mb4
DATABASE_URL="mysql+pymysql://root:password@127.0.0.1:3306/medicompass?charset=utf8mb4"

# Secret used to sign admin session JWTs. Use a long random string (>=16 chars).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=

# Default admin account created by `python -m scripts.seed_admin`.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Anthropic API key for AI summarization (required for the AI feature).
ANTHROPIC_API_KEY=
# Optional: custom API base URL (proxy/gateway). Leave blank for official API.
ANTHROPIC_BASE_URL=
# Optional: model. Defaults to claude-opus-5.
ANTHROPIC_MODEL=

# Frontend origin allowed by CORS (the Next.js app).
FRONTEND_ORIGIN=http://localhost:3001

# Set to "true" in production (HTTPS) so the session cookie is marked Secure.
COOKIE_SECURE=false

# SMTP email (app/services/email.py). Set EMAIL_ENABLED=true and fill the rest
# to actually send; otherwise send_email() returns a graceful no-op.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Medicompass
SMTP_USE_TLS=true
SMTP_USE_SSL=false
