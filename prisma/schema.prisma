// Prisma schema for MediCompass second-opinion applications + admin.
// SQLite for local/single-host use; swap `provider`/`url` for Postgres later.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Application {
  id              String       @id @default(cuid())
  fullName        String
  email           String
  phone           String
  country         String
  needType        String
  destination     String?
  condition       String
  lang            String       @default("zh")
  status          String       @default("new") // new | reviewed
  aiSummary       String?
  aiSummaryStatus String       @default("pending") // pending | done | failed
  aiSummaryError  String?
  createdAt       DateTime     @default(now())
  attachments     Attachment[]

  @@index([createdAt])
}

model Attachment {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  originalName  String
  storedPath    String
  mimeType      String
  size          Int
  createdAt     DateTime    @default(now())

  @@index([applicationId])
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
